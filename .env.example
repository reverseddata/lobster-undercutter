# Copy to .env. Never commit .env.

# From bhopp.com: F12 > Console > localStorage.getItem("bhopp.token")
# Lasts 7 days and is not refreshed, the log warns in its last 24 hours.
BHOPP_TOKEN=

# true only logs what it would change.
DRY_RUN=false

# Lowest allowed price per item, comma separated or one per line in floors.txt.
# Use the product slug (the end of its bhopp.com URL) or the full name.
# "skip" excludes an item. Items with no floor are never touched.
# Example: FLOORS=harvester=5.00, corrupt=skip
FLOORS=

# Optional floor for every item without its own. Leave empty to touch only
# items listed above.
GLOBAL_FLOOR_USD=

# Items using the global floor won't drop more than this % in one change. 0 = off.
GLOBAL_MAX_DROP_PCT=25

UNDERCUT_STEP_CENTS=1
# How often to check, at least 30. Lower reacts faster and sends more requests.
POLL_SECONDS=60
# Optional shortest time between two changes to one offer. 0 = off.
COOLDOWN_SECONDS=0

# Show the account as online while this runs (works even with DRY_RUN=true).
ALWAYS_ONLINE=false

# Where original prices are remembered. Default: state.json here, or on the
# Railway volume when one is attached.
# STATE_FILE=state.json
